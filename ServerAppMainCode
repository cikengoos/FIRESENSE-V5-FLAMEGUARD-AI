# ============ HELPER FUNCTIONS ============
def default_bot(serial, name, location):
    return {
        'serial': serial, 'name': name, 'location': location,
        'status': 'offline', 'last_update': None, 'temp': 0.0,
        'humid': 0.0, 'ai_value': 'UNKNOWN', 'last_heartbeat': None
    }

def load_bots():
    if os.path.exists(DATA_FILE):
        try:
            with open(DATA_FILE, 'r') as f:
                return json.load(f)
        except:
            return {}
    return {}

def save_bots(bots):
    with open(DATA_FILE, 'w') as f:
        json.dump(bots, f, indent=4)

def update_offline_status(bots):
    now = datetime.now()
    for serial, bot in bots.items():
        if bot.get('last_heartbeat'):
            try:
                last_hb = datetime.fromisoformat(bot['last_heartbeat'])
                if now - last_hb > timedelta(minutes=15):
                    bot['status'] = 'offline'
            except:
                pass

# ============ FLASK ROUTES ============
@app.route('/')
def index():
    bots = load_bots()
    update_offline_status(bots)
    save_bots(bots)
    return render_template_string(INDEX_HTML, bots=bots)

@app.route('/bot/<serial>')
def bot_page(serial):
    bots = load_bots()
    update_offline_status(bots)
    save_bots(bots)
    bot = bots.get(serial)
    if not bot:
        return redirect(url_for('index'))
    return render_template_string(BOT_HTML, bot=bot)

@app.route('/manage')
def manage():
    bots = load_bots()
    return render_template_string(MANAGE_HTML, bots=bots)

@app.route('/add_bot', methods=['POST'])
def add_bot():
    serial = request.form.get('serial')
    name = request.form.get('name')
    location = request.form.get('location')
    if serial and name and location:
        bots = load_bots()
        if serial not in bots:
            bots[serial] = default_bot(serial, name, location)
            save_bots(bots)
    return redirect(url_for('manage'))

@app.route('/update_bot/<serial>', methods=['POST'])
def update_bot(serial):
    bots = load_bots()
    if serial in bots:
        bots[serial]['name'] = request.form.get('name', bots[serial]['name'])
        bots[serial]['location'] = request.form.get('location', bots[serial]['location'])
        save_bots(bots)
    return redirect(url_for('manage'))

@app.route('/delete_bot/<serial>', methods=['POST'])
def delete_bot(serial):
    bots = load_bots()
    if serial in bots:
        del bots[serial]
        save_bots(bots)
    return redirect(url_for('manage'))

@app.route('/api/telemetry/<serial>', methods=['POST'])
def telemetry(serial):
    try:
        data = request.get_json()
        bots = load_bots()
        if serial in bots:
            bots[serial]['temp'] = data.get('temp', 0)
            bots[serial]['humid'] = data.get('humid', 0)
            bots[serial]['ai_value'] = data.get('status_code', 'SAFE')
            bots[serial]['status'] = 'online'
            bots[serial]['last_update'] = datetime.now().strftime('%Y-%m-%d %H:%M:%S')
            bots[serial]['last_heartbeat'] = datetime.now().isoformat()
            save_bots(bots)
            print(f"✅ Bot {serial}: {data}")
            return jsonify({'status': 'ok'})
        else:
            return jsonify({'status': 'error', 'message': 'Bot not found'}), 404
    except Exception as e:
        print(f"Error: {e}")
        return jsonify({'status': 'error', 'message': str(e)}), 400

@app.route('/api/heartbeat/<serial>', methods=['POST'])
def heartbeat(serial):
    bots = load_bots()
    if serial in bots:
        bots[serial]['last_heartbeat'] = datetime.now().isoformat()
        bots[serial]['status'] = 'online'
        save_bots(bots)
        return jsonify({'status': 'ok'})
    return jsonify({'status': 'error', 'message': 'Bot not found'}), 404

