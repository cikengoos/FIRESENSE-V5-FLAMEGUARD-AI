# ============================================================
# BOT FLEET MANAGER — ONE-SHOT SETUP
# ============================================================

set -e

PROJECT_DIR="$HOME/bot_fleet"
SERVICE_NAME="botfleet"

echo "🤖 Bot Fleet Manager — Full Setup Starting..."
echo "=============================================="

# --- 1. System packages ---
echo "[1/7] Installing system packages..."
sudo apt update -y
sudo apt install -y python3-venv python3-pip

# --- 2. Project structure ---
echo "[2/7] Creating project structure..."
mkdir -p "$PROJECT_DIR/server"
mkdir -p "$PROJECT_DIR/pico"
cd "$PROJECT_DIR"

# --- 3. Virtual environment ---
echo "[3/7] Creating virtual environment..."
python3 -m venv "$PROJECT_DIR/venv"
source "$PROJECT_DIR/venv/bin/activate"

# --- 4. Install dependencies ---
echo "[4/7] Installing Python dependencies..."
pip install --upgrade pip >/dev/null
pip install Flask==3.0.0 gunicorn==21.2.0

# --- 5. Placeholder data file ---
echo "[5/7] Initializing data file..."
[ -f "$PROJECT_DIR/server/bots_data.json" ] || echo "{}" > "$PROJECT_DIR/server/bots_data.json"

# --- 6. WSGI entry point ---
echo "[6/7] Creating wsgi.py..."
cat > "$PROJECT_DIR/server/wsgi.py" << 'EOF'
from app import app

if __name__ == "__main__":
    app.run()
EOF

# --- 7. Systemd service ---
echo "[7/7] Installing systemd service..."
CURRENT_USER=$(whoami)

sudo tee /etc/systemd/system/${SERVICE_NAME}.service > /dev/null <<EOF
[Unit]
Description=Bot Fleet Manager (Gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
User=$CURRENT_USER
Group=$CURRENT_USER
WorkingDirectory=$PROJECT_DIR/server
ExecStart=$PROJECT_DIR/venv/bin/gunicorn -w 2 -b 0.0.0.0:5000 wsgi:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
EOF

sudo systemctl daemon-reload
sudo systemctl enable ${SERVICE_NAME}.service

# --- Done ---
IP_ADDR=$(hostname -I | awk '{print $1}')
echo ""
echo "=============================================="
echo "✅ SETUP COMPLETE"
echo "=============================================="
echo ""
echo "📁 Project: $PROJECT_DIR"
echo "🌐 Dashboard will be at: http://$IP_ADDR:5000"
echo ""
echo "👉 NEXT STEP: Paste your app.py into:"
echo "   $PROJECT_DIR/server/app.py"
echo ""
echo "Then start the service:"
echo "   sudo systemctl start $SERVICE_NAME"
echo ""
