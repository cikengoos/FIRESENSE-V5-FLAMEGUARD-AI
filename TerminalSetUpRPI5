# ============================================================
# BOT FLEET MANAGER — SETUP ONLY
# ============================================================

set -e

PROJECT_DIR="$HOME/bot_fleet"
SERVICE_NAME="botfleet"

echo "🤖 Bot Fleet Manager — Setup Only"
echo "=================================="

# --- 1. System packages ---
echo "[1/6] Installing system packages..."
sudo apt update -y
sudo apt install -y python3-venv python3-pip

# --- 2. Project structure ---
echo "[2/6] Creating project structure..."
mkdir -p "$PROJECT_DIR/server"

# --- 3. Virtual environment ---
echo "[3/6] Creating virtual environment..."
python3 -m venv "$PROJECT_DIR/venv"
source "$PROJECT_DIR/venv/bin/activate"

# --- 4. Install dependencies ---
echo "[4/6] Installing Python dependencies..."
pip install --upgrade pip >/dev/null
pip install Flask==3.0.0 gunicorn==21.2.0

# --- 5. Create empty files ---
echo "[5/6] Creating files..."
touch "$PROJECT_DIR/server/app.py"
touch "$PROJECT_DIR/server/wsgi.py"
[ -f "$PROJECT_DIR/server/bots_data.json" ] || echo "{}" > "$PROJECT_DIR/server/bots_data.json"

# --- 6. Systemd service file (not enabled, not started) ---
echo "[6/6] Creating systemd service file..."
CURRENT_USER=$(whoami)

sudo tee /etc/systemd/system/${SERVICE_NAME}.service > /dev/null <<EOF
[Unit]
Description=Bot Fleet Manager (Gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
User=$CURRENT_USER
Group=$CURRENT_USER
WorkingDirectory=$PROJECT_DIR/server
ExecStart=$PROJECT_DIR/venv/bin/gunicorn -w 2 -b 0.0.0.0:5000 wsgi:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
EOF

sudo systemctl daemon-reload

# --- Done ---
IP_ADDR=$(hostname -I | awk '{print $1}')
echo ""
echo "=============================================="
echo "✅ SETUP COMPLETE"
echo "=============================================="
echo ""
echo "📁 $PROJECT_DIR/server/app.py          (empty)"
echo "📁 $PROJECT_DIR/server/wsgi.py         (empty)"
echo "📁 $PROJECT_DIR/server/bots_data.json  ( { } )"
echo "🐍 $PROJECT_DIR/venv/"
echo "⚙️  /etc/systemd/system/${SERVICE_NAME}.service (installed, not enabled)"
echo ""
echo "🌐 When ready: http://$IP_ADDR:5000"
echo ""
